# Configuração pública do frontend. A chave publishable/anon não é segredo;
# a segurança dos dados depende das políticas RLS do Supabase.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ou_anon_key

# Apenas no servidor. Nunca use prefixo VITE_ na chave.
GROQ_API_KEY=
# Ative somente após confirmar que a organização Groq está no plano Free.
ALINHO_ENABLED=false
